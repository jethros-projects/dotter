{
  "name": "@jethros-projects/dotter",
  "version": "0.6.3-next.4",
  "description": "A typed SDK and command-line companion for OpenAI Dot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jethros-projects/dotter.git"
  },
  "homepage": "https://github.com/jethros-projects/dotter#readme",
  "bugs": {
    "url": "https://github.com/jethros-projects/dotter/issues"
  },
  "keywords": [
    "dotter",
    "chatgpt",
    "dot",
    "sdk",
    "cli",
    "typescript",
    "agents"
  ],
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./advanced": {
      "types": "./src/advanced.d.ts",
      "import": "./src/native.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "bin": {
    "dotter": "./bin/dotter.mjs"
  },
  "scripts": {
    "start": "node bin/dotter.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "registry": "node scripts/build-command-registry.mjs",
    "docs": "node scripts/build-cli-reference.mjs",
    "coverage:docs": "node scripts/build-coverage.mjs",
    "test:package": "node scripts/test-package.mjs",
    "verify": "npm run check && npm run typecheck && npm test && npm run test:package",
    "typecheck": "node scripts/typecheck.mjs",
    "test:e2e": "node scripts/e2e-sdk.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish"
  },
  "files": [
    "bin/",
    "src/",
    "docs/workflows.md",
    "docs/commands.md",
    "docs/contracts.md",
    "examples/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/architecture.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/SDK.md",
    "docs/agents.md",
    "AGENTS.md",
    "scripts/e2e-sdk.mjs",
    "scripts/e2e-sdk-checks.mjs",
    "docs/assets/dotter-terminal.png",
    "docs/assets/README.md",
    "docs/releasing.md",
    "docs/security-2026-10.md"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mime-types": "3.0.2",
    "ws": "8.22.0"
  },
  "bundleDependencies": [
    "ajv",
    "ajv-formats",
    "mime-types",
    "ws"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "types": "./src/index.d.ts",
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
